# Supabase Local & Cloud Configuration
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=superadmin@tripmate.in
DEMO_USER_PASSWORD=
NEXT_PUBLIC_ENABLE_DEMO_ADMIN=true

# WhatsApp OTP Authentication Configuration
WA_AUTH_SECRET=                  # 32+ random chars: openssl rand -hex 32
WA_WORKER_URL=http://127.0.0.1:4100
WA_WORKER_SECRET=                # Must match worker WORKER_SECRET
WA_AUTH_DEV_LOG_OTP=true         # Dev only: prints OTP in server console
WA_SIMULATE_WORKER=false         # Set true for local testing without physical WhatsApp device
